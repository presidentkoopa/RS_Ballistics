# ============================================================================
# XIM'S TROOPERS FIRE RED BOLTS. Ship this as RSBDEFS inside the Xim REMA pack.
# Generated by RS_Ballistics tools/gen_starwars_profiles.py --enemies -- do not hand-edit.
# It replaces three RS_Ballistics round looks by name, only while this pack is loaded.
# ============================================================================

roundlook enemy_round   # a trooper's blaster bolt: red, as every hand blaster in the films
  look       = model, RSBMJ
  glide      = yes
  wake       = none
  impact     = sw_bolt_red
  whiz       = 60, rsb/whiz
  light      = 90, 2.2
  lightcolor = 255, 60, 50
  lightlook  = streak
end

roundlook enemy_pellet   # a spread of smaller bolts: red, as every hand blaster in the films
  look       = model, RSBMI
  glide      = yes
  wake       = none
  impact     = sw_bolt_red
  whiz       = 60, rsb/whiz
  light      = 90, 2.2
  lightcolor = 255, 60, 50
  lightlook  = streak
end

roundlook enemy_heavy   # a heavy repeater's bolt: red, as every hand blaster in the films
  look       = model, RSBMK
  glide      = yes
  wake       = none
  impact     = sw_bolt_red
  whiz       = 60, rsb/whiz
  light      = 110, 2.2
  lightcolor = 255, 60, 50
  lightlook  = streak
end

